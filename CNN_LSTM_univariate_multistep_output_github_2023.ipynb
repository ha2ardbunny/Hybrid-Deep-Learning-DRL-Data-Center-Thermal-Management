        "# 3. Create Sliding Windows (Crucial for CNN-LSTM)\n",
        "# This turns a flat list into sequences: [t-6, t-5, t-4, t-3, t-2, t-1] -> [t]\n",
        "def create_sequences(X, y, n_input, n_output):\n",
        "    X_seq, y_seq = [], []\n",
